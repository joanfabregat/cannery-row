{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannery-row.invalid/schemas/0.2/hypothesis.schema.json",
  "title": "Hypothesis draft (create or edit)",
  "description": "Client-supplied draft payload. The server assigns id, number, actor, via, timestamps, state and revision; they are rejected here.",
  "type": "object",
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "track": {"$ref": "common.schema.json#/$defs/slug"},
    "title": {"$ref": "common.schema.json#/$defs/text"},
    "question": {"$ref": "common.schema.json#/$defs/text"},
    "rationale": {"$ref": "common.schema.json#/$defs/text"},
    "intervention": {"$ref": "common.schema.json#/$defs/text"},
    "control": {
      "description": "Optional label of what the hypothesis compares against. Cannery Row stores and shows it, and pins it on the test job; the evaluator decides what it means.",
      "type": "object",
      "properties": {
        "kind": {"enum": ["baseline"]},
        "id": {"$ref": "common.schema.json#/$defs/slug"},
        "revision": {"$ref": "common.schema.json#/$defs/identifier"}
      },
      "required": ["kind", "id", "revision"],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "selection_splits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/slug"}
        },
        "confirmation_splits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/slug"}
        },
        "primary_metric": {"$ref": "common.schema.json#/$defs/name"},
        "required_slices": {
          "description": "Dimension names that must be reported per slice.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/name"}
        },
        "success_criteria": {"$ref": "common.schema.json#/$defs/text"},
        "falsification_criteria": {"$ref": "common.schema.json#/$defs/text"},
        "regression_gates": {
          "description": "Dimension names or evaluator gate ids guarded against regression; free text for humans and the evaluator.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"}
        },
        "compute_budget": {
          "description": "Upper bounds, each named <resource>_max.",
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,59}_max$": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "required": [
        "selection_splits",
        "confirmation_splits",
        "primary_metric",
        "required_slices",
        "success_criteria",
        "falsification_criteria",
        "regression_gates",
        "compute_budget"
      ],
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"enum": ["derived_from", "supersedes", "related_to"]},
          "hypothesis": {
            "oneOf": [
              {
                "description": "Number of a hypothesis in the same project.",
                "type": "integer",
                "minimum": 1
              },
              {
                "description": "A hypothesis in another project the caller can read.",
                "type": "object",
                "properties": {
                  "project": {"$ref": "common.schema.json#/$defs/slug"},
                  "number": {"type": "integer", "minimum": 1}
                },
                "required": ["project", "number"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["kind", "hypothesis"],
        "additionalProperties": false
      }
    },
    "project_fields": {"$ref": "common.schema.json#/$defs/open_object"}
  },
  "required": [
    "schema_version",
    "track",
    "title",
    "question",
    "rationale",
    "intervention",
    "plan"
  ],
  "additionalProperties": false
}

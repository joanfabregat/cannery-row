{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannery-row.invalid/schemas/0.2/science_revision.schema.json",
  "title": "Science revision",
  "description": "Immutable project science configuration pinned by every attempt. Secrets and live credentials are never embedded. Cannery Row keeps the metric registry and who verifies a run; the verifier's policy owns what a good result is. Cross-references (datasets and baselines in manifests) are checked by the service.",
  "type": "object",
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "unit_fields": {
      "description": "Project JSON Schema for unit project_fields.",
      "$ref": "common.schema.json#/$defs/json_schema"
    },
    "result_extensions": {
      "description": "Project JSON Schema for extensions of run documents and verification reports.",
      "$ref": "common.schema.json#/$defs/json_schema"
    },
    "verify": {
      "description": "Who verifies a submitted run. `runner`: the registered verifier service account runs the producer and the scorer again and applies its policy (`cannery runner`). `agent`: an agent service account or a researcher who did not run the attempt verifies it and writes the report.",
      "type": "object",
      "properties": {
        "performer": {"enum": ["runner", "agent"]},
        "verifier": {
          "description": "The registered verifier: the verifier service account name and the policy revision its reports must name.",
          "type": "object",
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/identifier"},
            "revision": {"$ref": "common.schema.json#/$defs/identifier"}
          },
          "required": ["id", "revision"],
          "additionalProperties": false
        }
      },
      "required": ["performer"],
      "additionalProperties": false,
      "if": {"properties": {"performer": {"const": "runner"}}, "required": ["performer"]},
      "then": {"required": ["verifier"]},
      "else": {"properties": {"verifier": {"not": {}}}}
    },
    "decide": {
      "description": "Who decides a written-up unit. `researcher` (the default when absent): a researcher records the decision document on its decision case. `step`: the registered decider service account runs its decider step (`cannery runner`, kind `decide`), which writes the decision document; it promotes only on a `pass` verdict, as a researcher does.",
      "type": "object",
      "properties": {
        "performer": {"enum": ["researcher", "step"]},
        "decider": {
          "description": "The registered decider: the decider service account name and the revision of its step, which every decision it records names.",
          "type": "object",
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/identifier"},
            "revision": {"$ref": "common.schema.json#/$defs/identifier"}
          },
          "required": ["id", "revision"],
          "additionalProperties": false
        }
      },
      "required": ["performer"],
      "additionalProperties": false,
      "if": {"properties": {"performer": {"const": "step"}}, "required": ["performer"]},
      "then": {"required": ["decider"]},
      "else": {"properties": {"decider": {"not": {}}}}
    },
    "metrics": {
      "description": "Metric registry.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/slug"},
          "revision": {"$ref": "common.schema.json#/$defs/identifier"},
          "held_out_labels": {
            "description": "True when the dataset holds labels only trusted steps that judge (the scorer, a policy step) may receive; a producer or experiment step never does.",
            "type": "boolean"
          },
          "description": {"$ref": "common.schema.json#/$defs/text"}
        },
        "required": ["id", "revision", "held_out_labels"],
        "additionalProperties": false
      }
    },
    "baselines": {
      "description": "Immutable baseline data references that steps may take as input (`from: baseline`). Baseline values belong to the verifier's policy.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/slug"},
          "revision": {"$ref": "common.schema.json#/$defs/identifier"},
          "description": {"$ref": "common.schema.json#/$defs/text"}
        },
        "required": ["id", "revision"],
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "items": {"$ref": "interface.schema.json"}
    },
    "validators": {
      "description": "Project validator steps. An interface names one (validator) to have the runner run it on each output of that interface; a non-zero exit fails the step that wrote the output.",
      "type": "array",
      "items": {
        "allOf": [{"$ref": "step_manifest.schema.json"}],
        "properties": {
          "spec": {"properties": {"role": {"const": "validator"}}}
        }
      }
    },
    "scorer": {
      "description": "The project scorer step manifest.",
      "allOf": [{"$ref": "step_manifest.schema.json"}],
      "properties": {
        "spec": {"properties": {"role": {"const": "scorer"}}}
      }
    },
    "default_producer": {"$ref": "common.schema.json#/$defs/producer_ref"},
    "code_repositories": {
      "description": "GitHub repositories (owner/name, any case) whose code steps may run (a step manifest's code.repo), per trust class: candidate for producer and experiment steps, trusted for the scorer, validators and policy steps. A class not listed runs no code from any repository.",
      "type": "object",
      "properties": {
        "candidate": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "step_manifest.schema.json#/$defs/repository"}
        },
        "trusted": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "step_manifest.schema.json#/$defs/repository"}
        }
      },
      "additionalProperties": false
    },
    "required_artifact_roles": {
      "type": "object",
      "properties": {
        "attempt": {
          "description": "Roles a submission's artifact manifest must include.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/name"}
        },
        "verify": {
          "description": "Roles a verify job's output manifest must include.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/name"}
        }
      },
      "required": ["attempt", "verify"],
      "additionalProperties": false
    },
    "retention": {
      "description": "Per-role retention; roles not listed are kept indefinitely.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {"$ref": "common.schema.json#/$defs/name"},
          "days": {"type": "integer", "minimum": 1}
        },
        "required": ["role", "days"],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "resource_ceilings": {
          "description": "Per-step resource limit ceilings.",
          "$ref": "common.schema.json#/$defs/resource_map"
        },
        "max_deadline_seconds": {
          "description": "Seconds a verify job may take beyond its steps (its policy); an agent verify job's whole deadline. Defaults to 3600.",
          "type": "integer",
          "minimum": 1
        },
        "report_max_bytes": {
          "description": "Cap on the body of a run document or a verification report, in bytes; at most 1 MiB.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_output_bytes": {"type": "integer", "minimum": 1}
      },
      "required": ["resource_ceilings", "report_max_bytes", "max_output_bytes"],
      "additionalProperties": false
    },
    "max_auto_retries": {
      "description": "Automatic reruns of a failed verify job.",
      "type": "integer",
      "minimum": 0,
      "default": 1
    }
  },
  "required": [
    "schema_version",
    "verify",
    "metrics",
    "datasets",
    "baselines",
    "interfaces",
    "scorer",
    "default_producer",
    "required_artifact_roles",
    "limits"
  ],
  "additionalProperties": false,
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "key": {"$ref": "common.schema.json#/$defs/name"},
        "unit": {"$ref": "common.schema.json#/$defs/text"},
        "direction": {"enum": ["higher", "lower"]},
        "aggregation": {"enum": ["mean", "median", "sum", "min", "max", "count"]},
        "dimensions": {
          "description": "Permitted dimensions, optionally with their allowed values.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "name": {"$ref": "common.schema.json#/$defs/name"},
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "common.schema.json#/$defs/text"}
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "splits": {
          "description": "Splits this metric applies to.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/slug"}
        },
        "required_slices": {
          "description": "Each value of the dimension must be reported (or explicitly missing) on each listed split, default all splits.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {"$ref": "common.schema.json#/$defs/name"},
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "common.schema.json#/$defs/text"}
              },
              "splits": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "common.schema.json#/$defs/slug"}
              }
            },
            "required": ["dimension", "values"],
            "additionalProperties": false
          }
        }
      },
      "required": ["key", "unit", "direction", "aggregation", "dimensions", "splits", "required_slices"],
      "additionalProperties": false
    }
  }
}

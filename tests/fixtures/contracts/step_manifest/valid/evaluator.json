{
  "apiVersion": "cannery-row/v1",
  "kind": "Step",
  "metadata": {
    "name": "custom-policy"
  },
  "spec": {
    "role": "evaluator",
    "code": {
      "repo": "pilchards/retrieval-scripts",
      "commit": "4f2a9c1e8b7d6a5f4e3d2c1b0a9f8e7d6c5b4a39",
      "path": "producers/sparse"
    },
    "setup": {
      "run": "pip install --require-hashes --no-deps --no-cache-dir --target /cr/cache/site -r requirements.txt",
      "cache": {
        "key_files": [
          "requirements.txt"
        ],
        "paths": [
          "site"
        ]
      },
      "activeDeadlineSeconds": 900
    },
    "container": {
      "image": "docker.io/library/python@sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "command": [
        "python",
        "produce.py"
      ],
      "env": [
        {
          "name": "PYTHONPATH",
          "value": "/cr/cache/site"
        }
      ],
      "resources": {
        "limits": {
          "cpu": "2",
          "memory": "4Gi"
        }
      }
    },
    "activeDeadlineSeconds": 3600,
    "network": "none",
    "sandbox": "Stock Python image; code and dependencies read-only, no network.",
    "inputs": {
      "artifacts": [
        {
          "name": "evidence",
          "from": "step",
          "interface": "ranked-run/v1",
          "path": "/cr/inputs/evidence"
        }
      ]
    },
    "outputs": {
      "artifacts": [
        {
          "name": "verdict",
          "path": "/cr/outputs/verdict"
        }
      ]
    }
  }
}

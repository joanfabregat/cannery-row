{
  "db_name": "PostgreSQL",
  "query": "SELECT r.kind AS \"kind!\", h.id AS \"unit_id!: _\", h.project_id AS \"project_id!: _\", p.slug AS \"project_slug!\", h.number AS \"number!\", h.title AS \"title!\", h.state AS \"state!\" FROM unit_relations r JOIN units h ON h.id=r.target_id JOIN projects p ON p.id=h.project_id WHERE r.unit_id=$1 ORDER BY r.kind,p.slug,h.number",

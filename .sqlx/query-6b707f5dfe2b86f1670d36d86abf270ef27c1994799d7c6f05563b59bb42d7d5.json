{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT h.number AS \"unit_number!\", h.title AS \"unit_title!\", h.state AS \"unit_state!\", t.slug AS \"track_slug!\", a.sequence AS \"attempt_sequence!\", f.stage AS \"stage!\", f.code AS \"code!\", f.reason AS \"reason!\", f.created_at AS \"created_at!: _\", a.origin AS \"origin!\" FROM attempt_failures f\n            JOIN attempts a ON a.id = f.attempt_id\n            JOIN units h ON h.id = a.unit_id\n            JOIN tracks t ON t.id = a.track_id\n            WHERE a.project_id = $1\n            ORDER BY f.created_at DESC, f.id DESC\n            LIMIT $2\n            ",

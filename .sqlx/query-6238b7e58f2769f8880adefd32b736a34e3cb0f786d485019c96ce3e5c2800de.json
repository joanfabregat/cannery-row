{
  "db_name": "PostgreSQL",
  "query": "SELECT p.attempt_id AS \"attempt_id: uuid::Uuid\", p.stage, p.revision, p.front_matter::text AS \"front_matter!\", p.body AS \"body!\", p.sha256 AS \"sha256?\", p.id AS \"id: uuid::Uuid\"\n           FROM phase_outputs p JOIN attempts a ON a.id=p.attempt_id\n           WHERE a.unit_id=$1 AND p.status='completed' AND p.stage IN ('agent','verification','writeup')\n           ORDER BY a.sequence, p.created_at, p.id",

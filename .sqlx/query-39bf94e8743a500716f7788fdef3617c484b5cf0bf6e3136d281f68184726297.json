  "query": "SELECT c.id AS \"id!: _\", c.project_id AS \"project_id!: _\", c.unit_id AS \"unit_id!: _\", h.number AS \"unit_number!\", h.state AS \"unit_state!\", c.attempt_id AS \"attempt_id?: _\", a.sequence AS \"attempt_sequence?\", a.state AS \"attempt_state?\", c.kind AS \"kind!\", c.subject_revision AS \"subject_revision!\", c.state AS \"state!\", c.opened_at AS \"opened_at!: _\", c.resolved_at AS \"resolved_at?: _\", c.failure_id AS \"failure_id?: _\", c.evidence_id AS \"evidence_id?: _\", c.writeup_id AS \"writeup_id?: _\", c.origin AS \"origin!\", c.source_ref AS \"source_ref?\" FROM \n    review_cases c JOIN units h ON h.id = c.unit_id\n    LEFT JOIN attempts a ON a.id = c.attempt_id\n WHERE c.id = $1 AND c.project_id = $2",

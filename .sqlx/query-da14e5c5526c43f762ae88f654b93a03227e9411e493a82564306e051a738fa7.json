{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT h.number AS \"unit_number!\", h.title AS \"unit_title!\", t.slug AS \"track_slug!\", a.sequence AS \"attempt_sequence!\", a.state AS \"state!\", a.claimed_at AS \"claimed_at!: _\" FROM attempts a\n            JOIN units h ON h.id = a.unit_id\n            JOIN tracks t ON t.id = a.track_id\n            WHERE a.project_id = $1 AND a.state = ANY($2)\n            ORDER BY a.claimed_at DESC, a.id DESC\n            LIMIT $3\n            ",

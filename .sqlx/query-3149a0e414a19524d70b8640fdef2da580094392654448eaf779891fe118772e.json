  "query": "\n            SELECT a.id AS \"id!: AttemptId\", a.project_id AS \"project_id!: ProjectId\", a.unit_id AS \"unit_id!: UnitId\", h.number AS \"unit_number!\", a.sequence AS \"sequence!\", a.state AS \"state!\", a.unit_revision AS \"unit_revision!\", a.science_revision AS \"science_revision!\", a.track_id AS \"track_id!: TrackId\", t.slug AS \"track_slug!\", a.producer AS \"producer?: JsonbText\", a.claimed_by_user AS \"claimed_by_user?: UserId\", a.claimed_by_service AS \"claimed_by_service?: ServiceAccountId\", a.via_channel AS \"via_channel!\", a.via_client AS \"via_client?\", a.predecessor_id AS \"predecessor_id?: AttemptId\", a.lease_generation AS \"lease_generation!\", a.lease_token_hash AS \"lease_token_hash?\", a.lease_expires_at AS \"lease_expires_at?: Timestamp\", a.claimed_at AS \"claimed_at!: Timestamp\", a.started_at AS \"started_at?: Timestamp\", a.submitted_at AS \"submitted_at?: Timestamp\", a.finished_at AS \"finished_at?: Timestamp\", a.origin AS \"origin!\", a.source_ref AS \"source_ref?\", a.imported AS \"imported?: JsonbText\", a.workflow AS \"workflow?: JsonbText\", a.deadline AS \"deadline?: Timestamp\" FROM \n    attempts a JOIN units h ON h.id = a.unit_id JOIN tracks t ON t.id = a.track_id\n\n            WHERE h.project_id = $1 AND h.number = $2 AND a.sequence = $3\n            ",

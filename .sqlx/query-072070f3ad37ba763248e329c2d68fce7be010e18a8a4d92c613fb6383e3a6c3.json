  "query": "SELECT f.attempt_id AS \"attempt_id: uuid::Uuid\", f.stage, f.code, f.reason, f.log_refs::text AS \"log_refs!\"\n           FROM attempt_failures f JOIN attempts a ON a.id=f.attempt_id\n           WHERE a.unit_id=$1 ORDER BY a.sequence, f.created_at, f.id",

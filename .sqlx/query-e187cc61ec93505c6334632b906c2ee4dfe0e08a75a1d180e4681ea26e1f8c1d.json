  "query": "\n            SELECT id AS \"id!: UploadId\", role AS \"role!\", key AS \"key!\", interface AS \"interface?\", refusal AS \"refusal!: JsonbText\" FROM uploads\n            WHERE job_id = $1 AND state = 'failed' AND refusal IS NOT NULL\n            ORDER BY completed_at, id\n            ",

  "query": "\n            SELECT t.slug AS \"slug!\", t.state AS \"state!\", t.producer AS \"producer?: JsonbText\", t.mode AS \"mode!\", t.workflow AS \"workflow?: JsonbText\"\n            FROM hypotheses h JOIN tracks t ON t.id = h.track_id\n            WHERE h.id = $1\n            FOR SHARE OF t\n            ",

{
  "apiVersion": "cannery-row/v1",
  "kind": "Step",
  "metadata": {"name": "scripted-overlap-producer"},
  "spec": {
    "role": "producer",
    "code": {
      "repo": "joanfabregat/cannery-row",
      "commit": "0000000000000000000000000000000000000000",
      "path": "examples/fixture/steps"
    },
    "setup": {
      "run": "pip install --require-hashes --no-deps --only-binary :all: --no-cache-dir --disable-pip-version-check --target /cr/cache/site -r requirements.txt",
      "cache": {"key_files": ["requirements.txt"], "paths": ["site/iniconfig"]},
      "network": {"egress": ["pypi.org:443", "files.pythonhosted.org:443"]},
      "activeDeadlineSeconds": 300
    },
    "container": {
      "image": "docker.io/library/python@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b",
      "command": ["python", "produce_overlap.py"],
      "env": [
        {"name": "PYTHONPATH", "value": "/cr/cache/site"},
        {"name": "FIXTURE_SPLITTER", "value": "whitespace"}
      ],
      "resources": {"limits": {"cpu": "1", "memory": "256Mi"}}
    },
    "activeDeadlineSeconds": 120,
    "network": "none",
    "sandbox": "The stock Python image runs the fixture producer from a commit of this repository; its code and dependencies are read-only, and the step has no network.",
    "inputs": {
      "artifacts": [
        {"name": "candidate", "from": "attempt", "path": "/cr/inputs/candidate"},
        {"name": "queries", "from": "dataset", "path": "/cr/inputs/queries"}
      ]
    },
    "outputs": {
      "artifacts": [{"name": "run", "interface": "ranked-run/v1", "path": "/cr/outputs/run"}]
    }
  }
}

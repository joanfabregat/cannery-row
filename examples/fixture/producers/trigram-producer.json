{
  "apiVersion": "cannery-row/v1",
  "kind": "Step",
  "metadata": {"name": "trigram-producer"},
  "spec": {
    "role": "producer",
    "container": {
      "image": "fixture.invalid/cannery-row/trigram-producer@sha256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2",
      "command": ["python3", "produce_trigram.py"],
      "args": ["--n", "3"],
      "resources": {"limits": {"cpu": "1", "memory": "256Mi"}}
    },
    "activeDeadlineSeconds": 120,
    "network": "none",
    "sandbox": "Fixture only: the local-process backend does not isolate the step.",
    "inputs": {
      "artifacts": [
        {"name": "candidate", "from": "attempt", "path": "/cr/inputs/candidate"},
        {"name": "queries", "from": "dataset", "path": "/cr/inputs/queries"}
      ]
    },
    "outputs": {
      "artifacts": [{"name": "run", "interface": "ranked-run/v1", "path": "/cr/outputs/run"}]
    }
  }
}

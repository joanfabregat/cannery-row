# Copy to dev/local.env (git-ignored) and fill in. Sourced by dev/common.sh.

# Domain under which run-podman --serve NAME:PORT is reachable as https://NAME.<domain>.
DEV_DOMAIN=dev.example.com

# OIDC application for sign-in on the dev instance; its redirect URI must be
# https://cannery.<DEV_DOMAIN>/auth/callback. Leave empty for bearer tokens only.
DEV_OIDC_ISSUER=https://issuer.example/oidc
DEV_OIDC_CLIENT_ID=
# An executable that prints the client secret on stdout.
DEV_OIDC_SECRET_COMMAND=
# Verified emails that become installation admins on first sign-in.
DEV_ADMIN_EMAILS=you@example.com

# Optional: the Cargo container wrapper, a scratch root and a state root the
# container runner can mount.
# RUN_RUST=run-rust
# WORK_ROOT=/tmp
# STATE_ROOT=$HOME/.local/state/cannery-row

{
  "schema_version": "0.2",
  "verify": {"performer": "agent"},
  "hypothesis_fields": {
    "type": "object",
    "properties": {
      "factors": {"type": "integer", "minimum": 1, "description": "Latent factors of a factorization model."},
      "seed": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  },
  "metrics": [
    {
      "key": "recall_at_10",
      "unit": "ratio",
      "direction": "higher",
      "aggregation": "mean",
      "dimensions": [{"name": "user_segment", "values": ["new", "returning"]}],
      "splits": ["validation"],
      "required_slices": [{"dimension": "user_segment", "values": ["new", "returning"]}]
    },
    {
      "key": "ndcg_at_10",
      "unit": "ratio",
      "direction": "higher",
      "aggregation": "mean",
      "dimensions": [{"name": "user_segment", "values": ["new", "returning"]}],
      "splits": ["validation"],
      "required_slices": []
    },
    {
      "key": "catalog_coverage",
      "unit": "ratio",
      "direction": "higher",
      "aggregation": "mean",
      "dimensions": [],
      "splits": ["validation"],
      "required_slices": []
    }
  ],
  "datasets": [
    {"id": "toy-ratings", "revision": "toy-ratings-2026-08", "held_out_labels": false, "description": "Demo data: 410,000 synthetic implicit-feedback events from 18,000 users on a 3,200-item catalog of a fictional online shop, training weeks only."},
    {"id": "toy-ratings-holdout", "revision": "toy-ratings-2026-08", "held_out_labels": true, "description": "Demo data: the last week of events per user, held out for scoring."}
  ],
  "baselines": [
    {"id": "popularity", "revision": "r1", "description": "Demo control: the 10 most popular items of the last 30 days for everyone; validation recall@10 0.082."}
  ],
  "interfaces": [
    {
      "name": "recommendations",
      "version": 1,
      "encoding": "jsonl",
      "media_type": "application/jsonl",
      "max_bytes": 8388608,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["user", "items"],
        "properties": {
          "user": {"type": "string"},
          "items": {"type": "array", "maxItems": 10, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  ],
  "scorer": {
    "apiVersion": "cannery-row/v1",
    "kind": "Step",
    "metadata": {"name": "recsys-scorer"},
    "spec": {
      "role": "scorer",
      "container": {
        "image": "registry.example/demo/recsys-scorer@sha256:a6b3cdb135582eb393389a78ce898416b95937e2af5da51a74e05d5ba9e09ec5",
        "command": ["python3", "score.py"],
        "resources": {"limits": {"cpu": "1", "memory": "1Gi"}}
      },
      "activeDeadlineSeconds": 600,
      "network": "none",
      "sandbox": "Demo data: runs no candidate code and reads only its declared inputs.",
      "inputs": {
        "artifacts": [
          {"name": "run", "from": "step", "interface": "recommendations/v1", "path": "/cr/inputs/run"},
          {"name": "holdout", "from": "dataset", "id": "toy-ratings-holdout", "path": "/cr/inputs/holdout"},
          {"name": "claimed_sheet", "from": "attempt", "path": "/cr/inputs/claimed_sheet"}
        ]
      },
      "outputs": {
        "artifacts": [
          {"name": "evidence", "interface": "cr-evidence/v0.2", "path": "/cr/outputs/evidence"}
        ]
      }
    }
  },
  "default_producer": {"name": "recsys-producer", "revision": 1},
  "required_artifact_roles": {"attempt": ["candidate"], "verify": ["step_log"]},
  "limits": {
    "resource_ceilings": {"cpu": "4", "memory": "8Gi"},
    "max_deadline_seconds": 3600,
    "report_max_bytes": 65536,
    "max_output_bytes": 104857600
  },
  "max_auto_retries": 1
}

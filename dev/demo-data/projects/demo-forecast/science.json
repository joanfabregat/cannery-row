{
  "schema_version": "0.2",
  "verify": {"performer": "runner", "verifier": {"id": "demo-verifier", "revision": "forecast-policy-1"}},
  "unit_fields": {
    "type": "object",
    "properties": {
      "horizon_days": {"type": "integer", "minimum": 1, "maximum": 14, "description": "Longest horizon the model forecasts."},
      "seed": {"type": "integer", "minimum": 0}
    },
    "additionalProperties": false
  },
  "metrics": [
    {
      "key": "mase",
      "unit": "ratio",
      "direction": "lower",
      "aggregation": "mean",
      "dimensions": [{"name": "horizon", "values": ["d1", "d7"]}],
      "splits": ["backtest"],
      "required_slices": [{"dimension": "horizon", "values": ["d1", "d7"]}]
    },
    {
      "key": "mape",
      "unit": "percent",
      "direction": "lower",
      "aggregation": "mean",
      "dimensions": [{"name": "horizon", "values": ["d1", "d7"]}],
      "splits": ["backtest"],
      "required_slices": []
    },
    {
      "key": "interval_coverage_80",
      "unit": "ratio",
      "direction": "higher",
      "aggregation": "mean",
      "dimensions": [],
      "splits": ["backtest"],
      "required_slices": []
    }
  ],
  "datasets": [
    {"id": "bakery-sales", "revision": "bakery-sales-2026-06", "held_out_labels": false, "description": "Demo data: synthetic daily unit sales of 40 products in 12 shops of a fictional bakery chain, January 2023 to March 2026, with holidays and weather."},
    {"id": "bakery-sales-future", "revision": "bakery-sales-2026-06", "held_out_labels": true, "description": "Demo data: the 13 weekly backtest windows of April to June 2026, read only by the scorer."}
  ],
  "baselines": [
    {"id": "seasonal-naive", "revision": "r1", "description": "Demo control: last week's sales on the same weekday; backtest MASE 1.00 by definition."}
  ],
  "interfaces": [
    {
      "name": "forecasts",
      "version": 1,
      "encoding": "jsonl",
      "media_type": "application/jsonl",
      "max_bytes": 16777216,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["shop", "product", "date", "mean"],
        "properties": {
          "shop": {"type": "string"},
          "product": {"type": "string"},
          "date": {"type": "string"},
          "mean": {"type": "number", "minimum": 0},
          "p10": {"type": "number", "minimum": 0},
          "p90": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  ],
  "scorer": {
    "apiVersion": "cannery-row/v1",
    "kind": "Step",
    "metadata": {"name": "forecast-scorer"},
    "spec": {
      "role": "scorer",
      "container": {
        "image": "registry.example/demo/forecast-scorer@sha256:2177dfe0707248216e39b616045de5198f5e57f47fce1eaebfde5dc834e21347",
        "command": ["python3", "score.py"],
        "resources": {"limits": {"cpu": "1", "memory": "1Gi"}}
      },
      "activeDeadlineSeconds": 600,
      "network": "none",
      "sandbox": "Demo data: runs no candidate code and reads only its declared inputs.",
      "inputs": {
        "artifacts": [
          {"name": "run", "from": "step", "interface": "forecasts/v1", "path": "/cr/inputs/run"},
          {"name": "future", "from": "dataset", "id": "bakery-sales-future", "path": "/cr/inputs/future"},
          {"name": "claimed_sheet", "from": "attempt", "path": "/cr/inputs/claimed_sheet"}
        ]
      },
      "outputs": {
        "artifacts": [
          {"name": "evidence", "interface": "cr-evidence/v0.2", "path": "/cr/outputs/evidence"}
        ]
      }
    }
  },
  "default_producer": {"name": "forecast-producer", "revision": 1},
  "required_artifact_roles": {"attempt": ["candidate"], "verify": ["evidence", "step_log"]},
  "limits": {
    "resource_ceilings": {"cpu": "4", "memory": "8Gi"},
    "max_deadline_seconds": 3600,
    "report_max_bytes": 65536,
    "max_output_bytes": 104857600
  },
  "max_auto_retries": 1
}

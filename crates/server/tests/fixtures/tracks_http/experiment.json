{
  "apiVersion": "cannery-row/v1",
  "kind": "Step",
  "metadata": {
    "name": "experiment"
  },
  "spec": {
    "role": "experiment",
    "container": {
      "image": "docker.io/library/python@sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "command": [
        "python",
        "produce.py"
      ],
      "env": [
        {
          "name": "PYTHONPATH",
          "value": "/cr/cache/site"
        }
      ],
      "resources": {
        "limits": {
          "cpu": "2",
          "memory": "4Gi"
        }
      }
    },
    "activeDeadlineSeconds": 3600,
    "network": "none",
    "sandbox": "Stock Python image; code and dependencies read-only, no network.",
    "inputs": {
      "artifacts": [
        {
          "name": "queries",
          "from": "dataset",
          "path": "/cr/inputs/queries"
        }
      ]
    },
    "outputs": {
      "artifacts": [
        {
          "name": "ranking",
          "interface": "ranked-run/v1",
          "path": "/cr/outputs/ranking"
        },
        {
          "name": "candidate_checkpoint",
          "interface": "ranked-run/v1",
          "path": "/cr/outputs/candidate_checkpoint"
        },
        {
          "name": "run",
          "interface": "cr-run/v0.2",
          "path": "/cr/outputs/run"
        }
      ]
    }
  }
}
